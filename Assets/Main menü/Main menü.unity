  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "R\xFCyadan Ka\xE7\u0131\u015F, a\u011F\u0131r ders y\xFCk\xFC, bitmeyen
    sayfalar ve yakla\u015Fan s\u0131nav saatinin yaratt\u0131\u011F\u0131 zihinsel
    \xE7\xF6k\xFC\u015F nedeniyle kabus dolu bir r\xFCya d\xF6ng\xFCs\xFCne hapsolmu\u015F
    \xFCniversite \xF6\u011Frencisi gen\xE7 bir k\u0131z\u0131n hik\xE2yesini konu
    alan psikolojik korku ve ka\xE7\u0131\u015F odas\u0131 oyunudur. Karakterin ger\xE7ek
    hayatta y\xFCzle\u015Fmekten ka\xE7t\u0131\u011F\u0131 t\xFCm akademik bask\u0131lar
    ve soyut korkular, bu r\xFCyada fiziksel ve \xF6l\xFCmc\xFCl birer tehdide d\xF6n\xFC\u015F\xFCr.
    Oyuncu; tehlike olarak yukar\u0131dan d\xFC\u015Fen kitaplarla kaotikle\u015Fen
    lo\u015F bir k\xFCt\xFCphanede uyan\u0131r, klostrofobik okul koridorlar\u0131nda
    k\xF6r noktalardan beliren agresif bir zombiden ka\xE7ar ve nihayetinde gece
    karanl\u0131\u011F\u0131nda, ya\u011Fan ya\u011Fmur alt\u0131nda Hacettepe \xDCniversitesi
    Ba\u015Fkent MYO Bah\xE7esi'nde vah\u015Fi k\xF6pekleri atlatarak hayatta kalma
    m\xFCcadelesi verir."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
